# Copy this file to .env. Never commit .env or real credentials.
OPENAI_API_KEY=replace-with-your-personal-openai-api-key

# Optional model and retrieval overrides
RAGAS_ANSWER_MODEL=gpt-4.1-mini
RAGAS_EVAL_MODEL=gpt-4.1-mini
RAGAS_EMBEDDING_MODEL=text-embedding-3-small
RAGAS_EVAL_MAX_WORKERS=1
RAGAS_EVAL_MAX_RETRIES=20
RAGAS_EVAL_MAX_WAIT=90
RAGAS_TESTSET_SOURCE_CHUNKS=24
RAGAS_TOP_K=5
RAGAS_CHUNK_TOKENS=800
RAGAS_CHUNK_OVERLAP=120
